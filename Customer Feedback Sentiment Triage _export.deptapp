tusType":"auto","x":1000,"y":520,"wires":[]},{"id":"e621c61494495c4b","type":"debug","z":"b3c08120a81f187b","name":"debug: Escalation Route","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1678,"y":672,"wires":[]},{"id":"edfb6f08812499f8","type":"debug","z":"b3c08120a81f187b","name":"debug: Normal Log Route","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1678,"y":796,"wires":[]},{"id":"d7c824c21b1c35fc","type":"enabler-llm","z":"b3c08120a81f187b","name":"Classify Feedback ","config":"a1b2c3d4e5f60001","model":"gpt-4o","slug":"ntt","projectid":"59130a7b-7948-42c3-83cb-990c1af4657c","x":756.8,"y":680,"wires":[["4fccb50a1fac16b4","7818d2401324a346"]]},{"id":"7818d2401324a346","type":"debug","z":"b3c08120a81f187b","name":"debug: LLM Output","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":860,"y":540,"wires":[]},{"id":"1c38c69ec8a08711","type":"function","z":"b3c08120a81f187b","name":"Fallback Classification","func":"// You can use lodash@4.17.15 through the object keyword '_'\n// for example _.isEmpty(var) - https://lodash.com/docs/4.17.15\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node,\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n\nmsg.classification = {\n    sentiment: \"neutral\",\n    category: \"other\",\n    urgency: 2,\n    summary: \"Feedback could not be automatically classified.\"\n};\n\nmsg.us